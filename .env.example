TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
API_PORT=3000
# Optional: set this if the local API runs somewhere other than API_PORT.
# VITE_API_PROXY_TARGET=http://localhost:3000

# Sentry error monitoring. Get the DSN from your Sentry project settings.
# Leave blank locally to disable Sentry — the app runs fine without it.
# In production, set this in the Vercel dashboard (Settings → Environment Variables).
SENTRY_DSN=
# Optional Sentry tuning:
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
